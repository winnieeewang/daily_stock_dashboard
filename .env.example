# 本地开发环境变量模板（.env）
#
# 使用方式：
#   1. 复制本文件为 .env：            cp .env.example .env
#   2. 把 "your-xxx-key-here" 替换为真实 key
#   3. .env 已在 .gitignore，绝不会入仓
#   4. 运行前加载：                    python -m dotenv secrets_loader.py
#      （或任何会读 .env 的入口；stock_dashboard.py / app.py 通过
#       utils._get_secret → os.environ 读取，.env 加载后即可生效）
#
# 生产环境（CI / Streamlit Cloud）不要依赖本文件，改用各自平台的 Secrets：
#   - GitHub Actions: repo Settings → Secrets → Actions（workflow 用 ${{ secrets.NAME }} 注入）
#   - Streamlit Cloud: app Settings → Secrets（运行时注入 st.secrets）

# --- AI 研判（必需至少配一个；否则 secrets_loader 报错退出）---
DEEPSEEK_API_KEY=your-deepseek-key-here
# OPENROUTER_API_KEY=your-openrouter-key-here

# --- 行情 / 数据 ---
ALPHA_API=your-alpha-vantage-key-here

# --- 美股 / 宏观新闻 ---
FRED_API=your-fred-key-here
SERPAPI=your-serpapi-key-here

# --- Telegram 推送 ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
