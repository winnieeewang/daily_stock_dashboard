# Streamlit Secrets 模板（本地开发用）
#
# 使用方式：
#   1. 复制本文件为 secrets.toml：    cp secrets.toml.example secrets.toml
#   2. 把 "your-xxx-key-here" 替换为真实 key
#   3. secrets.toml 已加入 .gitignore，绝不会入仓
#
# 生产部署时，把下面 toml 整段复制到 Streamlit Cloud 控制台：
#   https://share.streamlit.io/  →  你的 app  →  「Manage app」  →  「Secrets」

# --- AI 研判（必须至少配一个）---
DEEPSEEK_API_KEY     = "your-deepseek-key-here"
# OPENROUTER_API_KEY = "your-openrouter-key-here"   # 可选，DeepSeek 兜底

# --- 行情 / 数据（可选）---
# Alpha Vantage 期权链 PCR / 技术指标
ALPHA_API = "your-alpha-vantage-key-here"
# 同花顺 Financial-API 实时行情 / K线（注册 https://fuyao.aicubes.cn/admin/）
HITHINK_FINANCE_API_KEY = "your-hithink-key-here"
# Polygon.io 美股实时/历史行情（注册 https://polygon.io/dashboard/signup，免费档延迟15分钟+5req/min）
POLYGON_API_KEY = "your-polygon-key-here"

# --- 美股 / 宏观新闻（全部可选）---
FRED_API    = "your-fred-key-here"
SERPAPI     = "your-serpapi-key-here"
FINNHUB_API = "your-finnhub-key-here"
NEWSAPI_KEY = "your-newsapi-key-here"

# --- Telegram 推送（可选，CI 跑完把报告发到频道）---
TELEGRAM_BOT_TOKEN = "your-telegram-bot-token-here"
TELEGRAM_CHAT_ID   = "your-telegram-chat-id-here"

# --- 富途本地 OpenD 网关（云端勿加）---
# USE_FUTU        = "true"
# FUTU_OPEND_HOST = "127.0.0.1"
# FUTU_OPEND_PORT = "11111"
